{
    "name":  "desktop",
    "private":  true,
    "version":  "0.0.0",
    "type":  "module",
    "scripts":  {
                    "dev":  "vite --host 127.0.0.1 --strictPort",
                    "build":  "tsc -b \u0026\u0026 vite build",
                    "lint":  "eslint .",
                    "test:backend": "node --test electron/services/*.test.cjs",
                    "preview":  "vite preview",
                    "desktop":  "set ELECTRON_RUN_AS_NODE=\u0026\u0026 electron .",
                    "desktop:dev":  "node scripts/start-desktop-dev.cjs"
                },
    "dependencies":  {
                         "@monaco-editor/react":  "^4.7.0",
                         "@tailwindcss/vite":  "^4.3.3",
                         "@xterm/addon-fit":  "^0.11.0",
                         "@xterm/xterm":  "^6.0.0",
                         "lucide-react":  "^1.28.0",
                         "monaco-editor":  "^0.56.0",
                         "node-pty":  "^1.1.0",
                         "react":  "^19.2.8",
                         "react-dom":  "^19.2.8",
                         "tailwindcss":  "^4.3.3",
                         "zustand":  "^5.0.14"
                     },
    "devDependencies":  {
                            "@eslint/js":  "^10.0.1",
                            "@types/node":  "^24.13.3",
                            "@types/react":  "^19.2.17",
                            "@types/react-dom":  "^19.2.3",
                            "@vitejs/plugin-react":  "^6.0.4",
                            "electron":  "^43.4.0",
                            "eslint":  "^10.8.0",
                            "eslint-plugin-react-hooks":  "^7.1.1",
                            "eslint-plugin-react-refresh":  "^0.5.3",
                            "globals":  "^17.7.0",
                            "typescript":  "~6.0.2",
                            "typescript-eslint":  "^8.65.0",
                            "vite":  "^8.2.0"
                        },
    "main":  "electron/main.cjs",
    "allowScripts":  {
                         "node-pty@1.1.0":  true
                     }
